{
  "name": "salon-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test:step4": "npm run build && node --test dist/tests/step4_reception_test.js",
    "test:step5": "npm run build && node --test dist/tests/step5_barber_display_test.js && tsx --test ../frontend/tests/liveQueue.test.ts",
    "test:step6": "npm run build && node --test dist/tests/step6_owner_test.js",
    "start": "node dist/index.js",
    "credentials:bootstrap": "node dist/scripts/bootstrapCredentials.js",
    "test:credentials": "npm run build && node --test dist/tests/credential_access_test.js",
    "test:production": "npm run build && node --test dist/tests/production_readiness_test.js"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.19",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
