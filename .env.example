# Salon Queue Management System - Environment Configuration
# Copy this file to .env and set your secrets.
# NEVER commit the real .env file to version control.

# Staff PIN for Receptionist and Staff management actions
STAFF_PIN=

# Server Port
PORT=5001

# Local development simulator. Requires explicit opt-in and a private secret of at least 32 characters.
ENABLE_DEV_TEST=false
DEV_TEST_SECRET=

# Set a distinct private credential (4–128 characters) for each barber ID.
# Format: JSON object keyed by barber ID. Empty configuration disables login.
BARBER_CREDENTIALS='{}'

# Set a separate owner password (12–256 characters) in the local backend environment.
OWNER_PASSWORD=
